    {
      "parameters": {
        "jsCode": "let url = \"https://www.linkedin.com/jobs/search/?f_TPR=r86400\"\n\nconst keyword = $input.first().json.Keyword\nconst location = $input.first().json.Location\nconst experienceLevel = $input.first().json['Experience Level']\nconst remote = $input.first().json.Remote\nconst jobType = $input.first().json['Job Type']\nconst easyApply = $input.first().json['Easy Apply']\n\n// 1. Keyword\nif (keyword && keyword != \"\") {\n    url += `&keywords=${encodeURIComponent(keyword)}`;\n}\n\n// 2. Location\nif (location && location != \"\") {\n    url += `&location=${encodeURIComponent(location)}`;\n}\n// 3. Experience Level\nif (experienceLevel && experienceLevel != \"\") {\n    const expMap = {\n        \"Internship\": \"1\",\n        \"Entry level\": \"2\",\n        \"Associate\": \"3\",\n        \"Mid-Senior level\": \"4\",\n        \"Director\": \"5\",\n        \"Executive\": \"6\"\n    };\n    const transformedExperiences = experienceLevel\n        .split(\",\")\n        .map(exp => exp.trim())\n        .filter(exp => expMap[exp])\n        .map(exp => expMap[exp]);\n        \n    if (transformedExperiences.length > 0) {\n        url += `&f_E=${transformedExperiences.join(\",\")}`;\n    }\n}\n\n// 4. Remote / Hybrid / On-Site \nif (remote && remote != \"\") {\n    const remoteMap = {\n        \"Remote\": \"2\",\n        \"Hybrid\": \"3\",\n        \"On-Site\": \"1\"\n    };\n    const transformedRemote = remote\n        .split(\",\")\n        .map(r => r.trim())\n        .filter(r => remoteMap[r])\n        .map(r => remoteMap[r]);\n        \n    if (transformedRemote.length > 0) {\n        url += `&f_WT=${transformedRemote.join(\",\")}`;\n    }\n}\n// 5. Job Type \nif (jobType && jobType != \"\") {\n    const jobTypeMap = {\n        \"Full-time\": \"F\",\n        \"Part-time\": \"P\",\n        \"Contract\": \"C\",\n        \"Temporary\": \"T\",\n        \"Other\": \"O\",\n        \"Internship\": \"I\"\n    };\n    const transformedJobType = jobType\n        .split(\",\")\n        .map(j => j.trim())\n        .filter(j => jobTypeMap[j])\n        .map(j => jobTypeMap[j]);\n        \n    if (transformedJobType.length > 0) {\n        url += `&f_JT=${transformedJobType.join(\",\")}`;\n    }\n}\n\n// 6. Easy Apply (FIXED: Only adds if the checkbox is TRUE)\nif (easyApply === true) {\n    url += \"&f_EA=true\";\n}\n\n// Return the final URL\nreturn { url };"
      },
